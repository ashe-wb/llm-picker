---
import Layout from '../layouts/Layout.astro';
import { loadSiteData } from '../lib/data';
import {
  BAND_LABELS,
  GLOSSARY_CATEGORIES,
  GLOSSARY_CATEGORY_BLURBS,
  GLOSSARY_CATEGORY_LABELS,
  bandOfQuant,
} from '../lib/schemas';

const { glossary } = loadSiteData();
const byId = new Map(glossary.map((t) => [t.id, t]));
const byCategory = GLOSSARY_CATEGORIES.map((c) => ({
  id: c,
  label: GLOSSARY_CATEGORY_LABELS[c],
  blurb: GLOSSARY_CATEGORY_BLURBS[c],
  terms: glossary.filter((t) => t.category === c),
}));

/** Which quant bands an entry's quants fall into — reinforces the band model. */
const bandsOf = (quants: string[]) => [
  ...new Set(quants.map((q) => bandOfQuant(q)).filter(Boolean)),
];
---

<Layout
  title="Glossary"
  description="Plain-language definitions for the quantization formats, memory jargon, runtimes and benchmarks used across this site."
>
  <article class="space-y-10">
    <header class="max-w-2xl">
      <p class="dslabel mb-2">Document · Plain-language definitions</p>
      <h1 class="font-mono text-2xl font-bold">Glossary</h1>
      <p class="mt-3 text-faded">
        Local AI has an abbreviation problem. Q4_K_M, BF16, MXFP4, GGUF, KV cache, MoE, BFCL —
        none of it is explained anywhere you first meet it, and much of it looks like a typo for
        something else. Everything this site puts on screen is defined here, in the order a
        newcomer tends to hit it.
      </p>
      <nav class="mt-5 flex flex-wrap gap-2">
        {byCategory.map((c) => (
          <a
            href={`#${c.id}`}
            class="border border-edge bg-panel px-2.5 py-1.5 font-mono text-xs hover:bg-rule/50"
          >
            {c.label} <span class="text-faded">({c.terms.length})</span>
          </a>
        ))}
      </nav>
    </header>

    {byCategory.map((cat) => (
      <section id={cat.id} class="scroll-mt-6 space-y-3">
        <div class="border-b border-edge pb-1">
          <h2 class="font-mono text-lg font-bold">{cat.label}</h2>
          <p class="mt-1 text-sm text-faded">{cat.blurb}</p>
        </div>

        <dl class="space-y-3">
          {cat.terms.map((t) => (
            <div id={t.id} class="scroll-mt-6 border border-edge bg-panel">
              <dt class="flex flex-wrap items-baseline gap-x-3 gap-y-1 border-b border-rule px-4 py-2">
                <span class="font-mono text-sm font-bold">{t.term}</span>
                {t.expands && <span class="text-sm text-faded">{t.expands}</span>}
                {bandsOf(t.quants).length > 0 && (
                  <span class="dslabel ml-auto">
                    {bandsOf(t.quants).map((b) => BAND_LABELS[b!]).join(' · ')} band
                  </span>
                )}
              </dt>
              <dd class="space-y-2 px-4 py-3">
                <p class="text-sm">{t.newbieExplainer}</p>
                {t.rule && (
                  <p class="border-l-2 border-ok bg-paper py-1.5 pl-3 pr-3 text-sm">
                    <span class="font-mono text-[12px] font-bold uppercase tracking-[0.14em] text-ok">
                      Rule of thumb
                    </span>
                    <span class="ml-2">{t.rule}</span>
                  </p>
                )}
                {t.quants.length > 0 && (
                  <p class="dsnote">
                    COVERS: {t.quants.join(' · ')}
                  </p>
                )}
                {(t.seeAlso.length > 0 || t.url) && (
                  <p class="dsnote">
                    {t.seeAlso.length > 0 && (
                      <>
                        SEE ALSO:{' '}
                        {t.seeAlso.map((ref, i) => (
                          <>
                            {i > 0 && ' · '}
                            <a href={`#${ref}`} class="underline underline-offset-2 hover:text-serious">
                              {byId.get(ref)?.term ?? ref}
                            </a>
                          </>
                        ))}
                      </>
                    )}
                    {t.seeAlso.length > 0 && t.url && ' — '}
                    {t.url && (
                      <a href={t.url} class="underline underline-offset-2 hover:text-serious">
                        source
                      </a>
                    )}
                  </p>
                )}
              </dd>
            </div>
          ))}
        </dl>
      </section>
    ))}

    <p class="max-w-2xl dsnote">
      Every quantization string this site recognises has an entry here — the build fails if one
      does not, so this page cannot fall behind the data.
      Something still unexplained? <a href="/methodology" class="underline underline-offset-2">Methodology</a>
      covers how the scores and the memory model work.
    </p>
  </article>
</Layout>
